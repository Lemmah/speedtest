[Unit]
Description=Distributed network speed-test agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/speedtest-agent --bind 0.0.0.0 --port 9876
Restart=on-failure
RestartSec=3
User=speedtest
Group=speedtest
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

